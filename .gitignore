# .NET
bin/
obj/
*.user
sim/.artifacts/

# Unity (game/ project, when it lands)
game/Library/
game/Temp/
game/Obj/
game/Logs/
game/UserSettings/
game/Build/
game/MemoryCaptures/

# OS noise
.DS_Store
Thumbs.db

# API tokens for the concept-art tooling. Never commit these.
.secrets/

# Generated concept art: reference only, regenerate rather than version it.
art/concept/

# Before/after captures from the screenshot harness. Evidence for a review, not source:
# regenerate them from the exe rather than versioning a few megabytes of PNG per pass.
art/review/

# Unity player builds (local). Releases are CI artifacts only.
game/Builds/
game/out/

# Import and tooling logs (local only)
.artifacts/

# Free third-party art packs. Re-downloadable input, not project source.
art/free/

# Agent worktrees and local Claude Code state
.claude/
art/audio/

# ---------------------------------------------------------------- Synty assets
# COMMERCIALLY LICENSED, AND THIS REPO IS PUBLIC. Synty's EULA permits use in a
# built product and forbids redistributing the source assets; a public git repo
# is redistribution. These are a re-downloadable input (SyntyPass -> My
# Downloads), exactly like art/free/, and they never belong in a commit.
#
# If the repo ever goes private this STILL stays ignored: a private repo can be
# made public with one click, and the assets would be published retroactively
# through history, which a .gitignore added later cannot undo.
game/Assets/Polygon/
game/Assets/Polygon*/
game/Assets/POLYGON*/
game/Assets/Synty/
game/Assets/Synty*/
game/Assets/Sidekick*/
game/Assets/Animation_Base_Locomotion/
game/Assets/ANIMATION*/
art/synty/
*.unitypackage
game/Assets/Synty.meta

# Synty-DERIVED assets generated by SyntyCrowdBuilder. The prefabs are only GUID
# references, but the *_smoothmesh.asset files bake Synty's actual mesh data, and
# baking someone's mesh into a new file does not change who owns it. All of it is
# regenerable: Cipher/Crowd/Build Synty Crowd.
game/Assets/Resources/Civilians/SM_Chr_*
game/Assets/Resources/Civilians/Synty_*
game/Assets/Resources/Civilians/SyntyCrowd.controller*
game/Assets/Resources/Collector/
game/Assets/Resources/Props/
