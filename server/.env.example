# Copy to server/.env and fill in.

ANTHROPIC_API_KEY=sk-ant-...

# Where the family reaches it. Used in push notifications so tapping opens the app.
HEARTH_URL=http://localhost:8787

PORT=8787

# Anyone with this can post to the channel. Give it to the family, nobody else.
HEARTH_PASSPHRASE=change-me

# Run `npm run keys` once, paste the results here, never change them again.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:jeffery.fenn@gmail.com

# --- Mail. No OAuth: 2FA on the account, then generate a 16-char app password
# --- at https://myaccount.google.com/apppasswords and paste it below.
GMAIL_USER=fennfamily@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Calendars. No OAuth either: in Google Calendar open Settings for the
# --- calendar, scroll to "Integrate calendar", copy the SECRET address in iCal
# --- format. Comma-separate several. Treat these like passwords.
CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/.../private-.../basic.ics

# --- Backup. A SEPARATE PRIVATE repo — never the public code repo. Create an
# --- empty private repo, then a fine-grained token with Contents: read+write.
BACKUP_GIT_REMOTE=https://x-access-token:github_pat_XXXX@github.com/YOURNAME/hearth-memory.git
BACKUP_DIR=/opt/hearth-backup

# --- The adults room. A second secret the children do not have. Without this
# --- there is only one room and everything is visible to everyone.
HEARTH_ADULT_PASSPHRASE=change-me-too
